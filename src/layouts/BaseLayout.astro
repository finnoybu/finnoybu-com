---
import '~/styles/global.css';
import starfield from '~/assets/starfield.svg?raw';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ken Tannenbaum · Software Engineer, Author, Entrepreneur',
  description = 'Ken Tannenbaum — software engineer, author, entrepreneur. Projects in AI governance, fiction, publishing, and digital forensics.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
// Social card: a still of the homepage ring (1200×630), shared by every page.
const ogImage = new URL('/og-image.jpg', Astro.site).toString();
const ogImageAlt =
  'Ken Tannenbaum — portrait at the centre of a ring of his projects, on a starfield.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="finnoybu.com" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..700,30..100&family=EB+Garamond:ital,wght@0,400..700;1,400..700&family=Inter:wght@400..700&family=JetBrains+Mono:wght@400..600&display=swap"
    />

    <meta name="theme-color" content="#0d1626" />
  </head>
  <body>
    <div class="starfield" set:html={starfield} aria-hidden="true"></div>
    <slot />
  </body>
</html>
