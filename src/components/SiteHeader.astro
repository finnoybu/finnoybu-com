---
// Slim header for sub-pages — a wordmark that returns to the home page.
// The home page has its own hero and does not use this.
---
<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__mark">
      <span aria-hidden="true">&larr;</span>
      <span>finnoybu.com</span>
    </a>
  </div>
</header>

<style>
  .site-header__inner {
    max-width: 48rem;
    margin: 0 auto;
    padding: 1.75rem 1.5rem 0;
  }
  .site-header__mark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .site-header__mark:hover {
    color: var(--accent-hi);
  }
</style>
