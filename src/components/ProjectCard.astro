---
import type { Project } from '~/data/projects';

type Tone = 'deep' | 'mid' | 'warm' | 'light';

interface Props {
  project: Project;
  tone: Tone;
}

const { project, tone } = Astro.props;

const toneClasses: Record<Tone, { name: string; line: string; marker: string; link: string; hover: string }> = {
  deep: {
    name: 'text-stratum-deep-ink',
    line: 'text-stratum-deep-muted',
    marker: 'text-brass',
    link: 'text-accent-hi',
    hover: 'hover:text-brass',
  },
  mid: {
    name: 'text-stratum-mid-ink',
    line: 'text-stratum-mid-ink/75',
    marker: 'text-brass',
    link: 'text-stratum-mid-ink',
    hover: 'hover:text-brass',
  },
  warm: {
    name: 'text-stratum-warm-ink',
    line: 'text-stratum-warm-ink/80',
    marker: 'text-brass',
    link: 'text-stratum-warm-ink',
    hover: 'hover:text-brass',
  },
  light: {
    name: 'text-stratum-light-ink',
    line: 'text-stratum-light-muted',
    marker: 'text-brass',
    link: 'text-accent',
    hover: 'hover:text-brass',
  },
};

const t = toneClasses[tone];
---
<article class="py-6 md:py-7 first:pt-0">
  <div class="flex items-baseline justify-between gap-4 mb-2 flex-wrap">
    <h3 class={`font-display text-2xl md:text-[1.65rem] font-medium leading-tight ${t.name}`}>
      {project.url ? (
        <a
          href={project.url}
          class={`${t.link} ${t.hover} no-underline transition-colors`}
          rel={project.url.startsWith('http') ? 'noopener' : undefined}
        >
          {project.name}
        </a>
      ) : (
        project.name
      )}
    </h3>
    {project.marker && (
      <span class={`font-mono text-[0.65rem] uppercase tracking-widest ${t.marker}`}>
        {project.marker}
      </span>
    )}
  </div>
  <p class={`max-w-prose leading-relaxed ${t.line}`}>
    {project.one_liner}
  </p>
</article>
