---
import type { Project } from '~/data/projects';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

const shortUrl = (url?: string) => {
  if (!url) return '';
  const u = new URL(url);
  const host = u.hostname.replace(/^www\./, '');
  return host === 'github.com' ? host + u.pathname : host;
};
---
<div class="saturn-stage-wrap">
  <div
    class="saturn-scene"
    id="saturnScene"
    tabindex="0"
    role="group"
    aria-label="Project ring — drag, click an icon, or use arrow keys"
  >
    {/* ring band — back half (behind the portrait) */}
    <svg class="saturn-band is-back" id="bandBack" aria-hidden="true">
      <ellipse class="band-glow" pathLength="1"></ellipse>
      <ellipse class="band-line--soft" pathLength="1"></ellipse>
      <ellipse class="band-line" pathLength="1"></ellipse>
    </svg>

    {/* the planet */}
    <div class="saturn-planet">
      <div class="saturn-planet__sphere" aria-hidden="true"></div>
      {/* body layer — clipped to the circle (the clean crop) */}
      <div class="saturn-planet__crop">
        <img
          class="saturn-planet__photo"
          src="/portrait.png"
          alt="Ken Tannenbaum"
        />
      </div>
      {/* head layer — same photo, top strip only, rises above the rim */}
      <img
        class="saturn-planet__head"
        src="/portrait.png"
        alt=""
        aria-hidden="true"
      />
    </div>

    {/* ring band — front half (clipped, in front of the portrait) */}
    <svg class="saturn-band is-front" id="bandFront" aria-hidden="true">
      <ellipse class="band-glow" pathLength="1"></ellipse>
      <ellipse class="band-line--soft" pathLength="1"></ellipse>
      <ellipse class="band-line" pathLength="1"></ellipse>
    </svg>

    {/* icons riding the ring */}
    <div class="saturn-orbit" id="saturnOrbit">
      {projects.map((p, i) => (
        <div
          class="saturn-node"
          data-index={i}
          data-id={p.id}
          data-name={p.name}
          data-tag={p.tag}
          data-blurb={p.blurb}
          data-details={p.details ?? ''}
          data-url={p.url ?? ''}
          data-monogram={p.monogram}
          data-preview={p.preview ?? ''}
          data-short-url={shortUrl(p.url)}
        >
          <div class="saturn-node__disc">{p.monogram}</div>
          <div class="saturn-node__label">{p.name}</div>
        </div>
      ))}
    </div>

    <div class="saturn-preview" id="saturnPreview" aria-hidden="true">
      <img class="saturn-preview__img" id="previewImg" alt="" decoding="async" />
      <p class="saturn-preview__url" id="previewUrl"></p>
      <p class="saturn-preview__pulse" id="previewPulse" hidden></p>
    </div>
  </div>

  <div class="saturn-detail" id="saturnDetail">
    <p class="saturn-detail__tag" id="detailTag"></p>
    <h2 class="saturn-detail__name" id="detailName"></h2>
    <p class="saturn-detail__blurb" id="detailBlurb"></p>
  </div>

  {/* expanded project view — overlays the faded ring */}
  <div class="project-detail" id="projectDetail" aria-hidden="true">
    <button class="project-detail__back" id="detailBack" type="button">
      &larr;&nbsp;Back to the system
    </button>
    <div class="project-detail__mark" id="pdMark" aria-hidden="true"></div>
    <p class="project-detail__tag" id="pdTag"></p>
    <h2 class="project-detail__name" id="pdName"></h2>
    <p class="project-detail__pulse" id="pdPulse" hidden></p>
    <div class="project-detail__body" id="pdBody"></div>
    <a
      class="project-detail__latest"
      id="pdLatest"
      target="_blank"
      rel="noopener"
      hidden
    ></a>
    <a
      class="project-detail__visit"
      id="pdVisit"
      target="_blank"
      rel="noopener"
    ></a>
  </div>

  {/* stand-in disc that flies between the ring and the detail view */}
  <div
    class="project-detail__mark is-ghost"
    id="flightGhost"
    aria-hidden="true"
    hidden
  ></div>
</div>

{/* Static fallback — reduced-motion, narrow screens, no-JS. */}
<div class="fallback-grid">
  <div class="fallback-grid__items">
    {projects.map((p) => (
      <a class="fallback-card" href={p.url ?? '#'}>
        {p.preview && (
          <img
            class="fallback-card__img"
            src={p.preview}
            alt=""
            width="640"
            height="336"
            loading="lazy"
            decoding="async"
          />
        )}
        <div class="fallback-card__body">
          <p class="fallback-card__tag">{p.tag}</p>
          <p class="fallback-card__name">{p.name}</p>
          <p class="fallback-card__pulse" data-pulse-for={p.id} hidden></p>
          <p class="fallback-card__blurb">{p.blurb}</p>
        </div>
      </a>
    ))}
  </div>
</div>


<script>
  const scene = document.getElementById('saturnScene');
  const orbit = document.getElementById('saturnOrbit');
  const bandBack = document.getElementById('bandBack');
  const bandFront = document.getElementById('bandFront');
  const detail = document.getElementById('saturnDetail');
  const dTag = document.getElementById('detailTag');
  const dName = document.getElementById('detailName');
  const dBlurb = document.getElementById('detailBlurb');
  const stage = document.querySelector<HTMLElement>('.saturn-stage-wrap');
  const projectDetail = document.getElementById('projectDetail');
  const detailBack = document.getElementById('detailBack');
  const pdMark = document.getElementById('pdMark');
  const pdTag = document.getElementById('pdTag');
  const pdName = document.getElementById('pdName');
  const pdBody = document.getElementById('pdBody');
  const pdVisit = document.getElementById('pdVisit');
  const ghost = document.getElementById('flightGhost');
  const preview = document.getElementById('saturnPreview');
  const previewImg = document.querySelector<HTMLImageElement>('#previewImg');
  const previewUrl = document.getElementById('previewUrl');
  const previewPulse = document.getElementById('previewPulse');
  const pdPulse = document.getElementById('pdPulse');
  const pdLatest = document.getElementById('pdLatest');

  if (
    scene && orbit && bandBack && bandFront &&
    detail && dTag && dName && dBlurb &&
    stage && projectDetail && detailBack && pdMark &&
    pdTag && pdName && pdBody && pdVisit && ghost &&
    preview && previewImg && previewUrl &&
    previewPulse && pdPulse && pdLatest
  ) {
    const nodes = Array.from(
      orbit.querySelectorAll<HTMLElement>('.saturn-node'),
    );
    const bandEllipses = [
      ...bandBack.querySelectorAll('ellipse'),
      ...bandFront.querySelectorAll('ellipse'),
    ];
    const N = nodes.length;
    const TAU = Math.PI * 2;
    const TILT_DEG = -23; // ring tilt — like Saturn's actual ring
    const RY_RATIO = 0.34; // ring's vertical squash
    const reduced = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;
    const finePointer = window.matchMedia('(pointer: fine)').matches;

    const clamp = (v: number, lo: number, hi: number) =>
      Math.min(hi, Math.max(lo, v));
    const easeOut = (t: number) => 1 - (1 - t) ** 3;

    let cx = 0, cy = 0, rx = 0;
    let spin = Math.PI / 2; // node 0 starts at front (bottom)
    let target: number | null = null;
    let dragging = false;
    let pointerInside = false;
    let startX = 0, startSpin = 0, moved = 0;
    let active = -1;
    let detailOpen = false;

    // cursor-driven tilt: current values ease toward the goals each frame
    let tiltDeg = TILT_DEG, tiltGoal = TILT_DEG;
    let ryRatio = RY_RATIO, ryGoal = RY_RATIO;

    const nodeX = new Array<number>(N).fill(0);
    const nodeY = new Array<number>(N).fill(0);
    const nodeScale = new Array<number>(N).fill(1);

    // ── first-visit entrance ─────────────────────────────────
    const INTRO_KEY = 'finnoybu:ring-intro-seen';
    const INTRO_MS = 1700;
    const STAGGER = Math.min(0.025, 0.3 / Math.max(N, 1));
    let introStart: number | null = null; // -1 = waiting for first frame
    if (!reduced) {
      try {
        if (!localStorage.getItem(INTRO_KEY)) {
          introStart = -1;
          localStorage.setItem(INTRO_KEY, '1');
        }
      } catch {
        // storage unavailable — skip the entrance rather than replay it
      }
    }
    const introK = new Array<number>(N).fill(introStart === null ? 1 : 0);

    const setBandDraw = (k: number | null) => {
      for (const el of bandEllipses) {
        el.style.strokeDasharray = k === null ? '' : `${k} 1`;
      }
    };

    const endIntro = () => {
      if (introStart === null) return;
      introStart = null;
      introK.fill(1);
      setBandDraw(null);
    };

    const setEllipse = (
      el: Element | undefined,
      ex: number, ey: number, erx: number, ery: number,
    ) => {
      if (!el) return;
      el.setAttribute('cx', String(ex));
      el.setAttribute('cy', String(ey));
      el.setAttribute('rx', String(erx));
      el.setAttribute('ry', String(ery));
    };

    const drawBands = () => {
      const ry = rx * ryRatio;
      for (const svg of [bandBack, bandFront]) {
        svg.style.transform = `rotate(${tiltDeg.toFixed(2)}deg)`;
        const e = svg.querySelectorAll('ellipse');
        setEllipse(e[0], cx, cy, rx, ry);
        setEllipse(e[1], cx, cy, rx * 0.82, ry * 0.82);
        setEllipse(e[2], cx, cy, rx, ry);
      }
    };

    const layout = () => {
      const r = scene.getBoundingClientRect();
      cx = r.width / 2;
      cy = r.height / 2;
      rx = Math.min(r.width * 0.42, 380);
      for (const svg of [bandBack, bandFront]) {
        svg.setAttribute('viewBox', `0 0 ${r.width} ${r.height}`);
      }
      drawBands();
    };

    const place = () => {
      const tilt = (tiltDeg * Math.PI) / 180;
      const cosT = Math.cos(tilt);
      const sinT = Math.sin(tilt);
      const ry = rx * ryRatio;
      for (let i = 0; i < N; i++) {
        const k = introK[i];
        // during the entrance, nodes spiral out from the planet
        const theta = (i / N) * TAU + spin + (1 - k) * 1.6;
        const px = rx * k * Math.cos(theta);
        const py = ry * k * Math.sin(theta);
        const x = cx + px * cosT - py * sinT;
        const y = cy + px * sinT + py * cosT;
        const depth = (Math.sin(theta) + 1) / 2; // 0 back .. 1 front
        const scale = (0.62 + 0.46 * depth) * (0.35 + 0.65 * k);
        nodeX[i] = x;
        nodeY[i] = y;
        nodeScale[i] = scale;
        const n = nodes[i];
        n.style.transform =
          `translate(calc(${x.toFixed(1)}px - 50%), calc(${y.toFixed(1)}px - 50%)) scale(${scale.toFixed(3)})`;
        n.style.opacity = ((0.4 + 0.6 * depth) * k).toFixed(3);
        n.style.zIndex = depth >= 0.5 ? '11' : '4';
      }
    };

    const frontIndex = () => {
      const idx = Math.round(((Math.PI / 2 - spin) / TAU) * N);
      return ((idx % N) + N) % N;
    };

    const swap = (node: HTMLElement) => {
      detail.classList.add('is-swapping');
      window.setTimeout(() => {
        dName.textContent = node.dataset.name || '';
        dTag.textContent = node.dataset.tag || '';
        dBlurb.textContent = node.dataset.blurb || '';
        detail.classList.remove('is-swapping');
      }, 160);
    };

    const refreshActive = () => {
      const idx = frontIndex();
      if (idx === active) return;
      active = idx;
      nodes.forEach((n, i) => n.classList.toggle('is-active', i === idx));
      swap(nodes[idx]);
    };

    const snapTo = (i: number) => {
      let t = Math.PI / 2 - (i / N) * TAU;
      while (t - spin > Math.PI) t -= TAU;
      while (t - spin < -Math.PI) t += TAU;
      target = t;
    };

    const resetTilt = () => {
      tiltGoal = TILT_DEG;
      ryGoal = RY_RATIO;
    };

    // ── hover preview card ───────────────────────────────────
    let hovered = -1;
    let previewsWarm = false;

    const warmPreviews = () => {
      if (previewsWarm) return;
      previewsWarm = true;
      for (const n of nodes) {
        if (n.dataset.preview) new Image().src = n.dataset.preview;
      }
    };

    // sits above the hovered disc; flips below it near the top of the scene
    const placePreview = () => {
      const n = nodes[hovered];
      const s = nodeScale[hovered];
      const cw = preview.offsetWidth;
      const ch = preview.offsetHeight;
      const discTop = nodeY[hovered] - (n.offsetHeight / 2) * s;
      let top = discTop - ch - 12;
      if (top < 0) top = nodeY[hovered] + (n.offsetHeight / 2) * s + 10;
      const left = clamp(
        nodeX[hovered] - cw / 2,
        0,
        scene.offsetWidth - cw,
      );
      preview.style.left = `${left.toFixed(1)}px`;
      preview.style.top = `${top.toFixed(1)}px`;
    };

    // ── signs of life (/api/pulse) ───────────────────────────
    // The route only ever reports good news, so absence means "say nothing".
    type PulseInfo = {
      live?: boolean;
      days?: number;
      latest?: { title: string; url: string };
    };
    let pulse: Record<string, PulseInfo> = {};
    const pulseFor = (i: number): PulseInfo | undefined =>
      pulse[nodes[i].dataset.id || ''];
    const pulseLabel = (p?: PulseInfo) => {
      if (!p) return '';
      const activity =
        p.days === undefined ? ''
        : p.days < 1 ? 'updated today'
        : p.days <= 7 ? 'active this week'
        : 'active this month';
      const text = [p.live ? 'Live' : '', activity].filter(Boolean).join(' · ');
      return text.charAt(0).toUpperCase() + text.slice(1);
    };
    const loadPulse = async () => {
      try {
        const res = await fetch('/api/pulse');
        if (!res.ok) return;
        pulse = ((await res.json()) as { projects?: typeof pulse }).projects ?? {};
      } catch {
        return;
      }
      nodes.forEach((node, i) => {
        const p = pulseFor(i);
        node.classList.toggle('is-live', !!p?.live);
        node.classList.toggle('is-busy', p?.days !== undefined && p.days <= 7);
      });
      // the static grid (phones, reduced motion) gets the status line too
      document
        .querySelectorAll<HTMLElement>('.fallback-card__pulse')
        .forEach((el) => {
          const p = pulse[el.dataset.pulseFor || ''];
          el.textContent = pulseLabel(p);
          el.hidden = !el.textContent;
          el.classList.toggle('is-live', !!p?.live);
        });
      if (hovered >= 0) showPreview(hovered);
    };
    const idle = (window as Window & {
      requestIdleCallback?: (cb: () => void, o?: { timeout: number }) => void;
    }).requestIdleCallback;
    if (idle) idle(() => void loadPulse(), { timeout: 2500 });
    else setTimeout(() => void loadPulse(), 1200);

    const showPreview = (i: number) => {
      const src = nodes[i].dataset.preview;
      if (!src || dragging || detailOpen) return;
      hovered = i;
      if (previewImg.getAttribute('src') !== src) previewImg.src = src;
      previewUrl.textContent = nodes[i].dataset.shortUrl || '';
      const p = pulseFor(i);
      const status = pulseLabel(p);
      previewPulse.textContent = status;
      if (p?.latest) {
        const line = document.createElement('span');
        line.className = 'saturn-preview__latest';
        line.textContent = `Latest: ${p.latest.title}`;
        previewPulse.appendChild(line);
      }
      previewPulse.hidden = !status && !p?.latest;
      previewPulse.classList.toggle('is-live', !!p?.live);
      placePreview();
      preview.classList.add('is-visible');
    };

    const hidePreview = () => {
      hovered = -1;
      preview.classList.remove('is-visible');
    };

    // ── disc flight between ring and detail view ─────────────
    // Spots come from layout offsets, not getBoundingClientRect, so the
    // scene's open/close scale transition doesn't skew the measurements.
    type Spot = { x: number; y: number; size: number };

    const discSpot = (i: number): Spot => {
      const n = nodes[i];
      const disc = n.firstElementChild as HTMLElement;
      const s = nodeScale[i];
      return {
        x: scene.offsetLeft + nodeX[i],
        y: scene.offsetTop + nodeY[i] -
          (n.offsetHeight / 2 - disc.offsetHeight / 2) * s,
        size: disc.offsetWidth * s,
      };
    };

    const markSpot = (): Spot => ({
      x: projectDetail.offsetLeft + pdMark.offsetLeft + pdMark.offsetWidth / 2,
      y: projectDetail.offsetTop + pdMark.offsetTop + pdMark.offsetHeight / 2 -
        projectDetail.scrollTop,
      size: pdMark.offsetWidth,
    });

    let flight: Animation | null = null;
    let settleFlight: (() => void) | null = null;

    const fly = (label: string, from: Spot, to: Spot, done: () => void) => {
      if (flight) {
        flight.cancel();
        settleFlight?.();
      }
      ghost.textContent = label;
      ghost.style.width = `${to.size}px`;
      ghost.style.height = `${to.size}px`;
      ghost.style.left = `${to.x - to.size / 2}px`;
      ghost.style.top = `${to.y - to.size / 2}px`;
      ghost.hidden = false;
      const dx = from.x - to.x;
      const dy = from.y - to.y;
      const s = from.size / to.size;
      settleFlight = () => {
        ghost.hidden = true;
        flight = null;
        settleFlight = null;
        done();
      };
      flight = ghost.animate(
        [
          { transform: `translate(${dx}px, ${dy}px) scale(${s})` },
          { transform: 'none' },
        ],
        { duration: 560, easing: 'cubic-bezier(0.22, 0.8, 0.24, 1)' },
      );
      flight.onfinish = () => settleFlight?.();
    };

    // ── project detail view ──────────────────────────────────
    const openDetail = (node: HTMLElement, i: number) => {
      const label = node.dataset.monogram || '';
      pdMark.textContent = label;
      pdTag.textContent = node.dataset.tag || '';
      pdName.textContent = node.dataset.name || '';
      pdBody.textContent =
        node.dataset.details || node.dataset.blurb || '';
      const url = node.dataset.url;
      if (url) {
        pdVisit.setAttribute('href', url);
        try {
          pdVisit.textContent =
            new URL(url).hostname.replace(/^www\./, '') + '  →';
        } catch {
          pdVisit.textContent = 'Visit →';
        }
        pdVisit.hidden = false;
      } else {
        pdVisit.hidden = true;
      }
      const p = pulseFor(i);
      pdPulse.textContent = pulseLabel(p);
      pdPulse.hidden = !pdPulse.textContent;
      pdPulse.classList.toggle('is-live', !!p?.live);
      if (p?.latest) {
        pdLatest.setAttribute('href', p.latest.url);
        pdLatest.textContent = `Latest: ${p.latest.title}  →`;
        pdLatest.hidden = false;
      } else {
        pdLatest.hidden = true;
      }
      projectDetail.scrollTop = 0;
      const from = discSpot(i);
      hidePreview();
      detailOpen = true;
      resetTilt();
      stage.classList.add('is-detail');
      projectDetail.setAttribute('aria-hidden', 'false');
      if (!reduced) {
        node.classList.add('is-flying');
        pdMark.classList.add('is-waiting');
        fly(label, from, markSpot(), () => {
          pdMark.classList.remove('is-waiting');
        });
      }
      detailBack.focus();
    };

    const closeDetail = () => {
      const i = active;
      const node = nodes[i];
      const from = markSpot();
      stage.classList.remove('is-detail');
      projectDetail.setAttribute('aria-hidden', 'true');
      scene.focus();
      if (reduced) {
        detailOpen = false;
        return;
      }
      pdMark.classList.add('is-waiting');
      fly(node.dataset.monogram || '', from, discSpot(i), () => {
        node.classList.remove('is-flying');
        pdMark.classList.remove('is-waiting');
        detailOpen = false;
      });
    };

    const frame = (now: number) => {
      if (introStart !== null) {
        if (introStart < 0) introStart = now;
        const t = (now - introStart) / INTRO_MS;
        const bandK = easeOut(clamp(t / 0.55, 0, 1));
        for (let i = 0; i < N; i++) {
          introK[i] = easeOut(clamp((t - 0.2 - i * STAGGER) / 0.6, 0, 1));
        }
        setBandDraw(bandK);
        if (bandK >= 1 && introK[N - 1] >= 1) endIntro();
      }

      const prevTilt = tiltDeg;
      const prevRy = ryRatio;
      tiltDeg += (tiltGoal - tiltDeg) * 0.06;
      ryRatio += (ryGoal - ryRatio) * 0.06;
      if (
        Math.abs(tiltDeg - prevTilt) > 1e-4 ||
        Math.abs(ryRatio - prevRy) > 1e-5
      ) {
        drawBands();
      }

      if (dragging) {
        // spin updated by pointermove
      } else if (target !== null) {
        spin += (target - spin) * 0.16;
        if (Math.abs(target - spin) < 0.0015) {
          spin = target;
          target = null;
        }
      } else if (!pointerInside && !reduced && !detailOpen) {
        spin -= 0.0014; // idle drift — slow, reversed
      }
      place();
      if (hovered >= 0) placePreview();
      refreshActive();
      requestAnimationFrame(frame);
    };

    layout();
    if (introStart !== null) setBandDraw(0);
    place();
    refreshActive();
    requestAnimationFrame(frame);

    window.addEventListener('resize', () => {
      layout();
      place();
    });

    scene.addEventListener('pointerenter', () => { pointerInside = true; });
    scene.addEventListener('pointerleave', () => {
      pointerInside = false;
      resetTilt();
    });

    if (finePointer && !reduced) {
      scene.addEventListener('pointermove', (e) => {
        if (detailOpen) return;
        const r = scene.getBoundingClientRect();
        const nx = clamp(((e.clientX - r.left) / r.width) * 2 - 1, -1, 1);
        const ny = clamp(((e.clientY - r.top) / r.height) * 2 - 1, -1, 1);
        tiltGoal = TILT_DEG + nx * 5;
        ryGoal = RY_RATIO - ny * 0.07;
      });

      scene.addEventListener('pointerenter', warmPreviews);
      nodes.forEach((node, i) => {
        node.addEventListener('pointerenter', () => showPreview(i));
        node.addEventListener('pointerleave', hidePreview);
      });
    }

    // NB: no setPointerCapture — capturing the pointer on the scene steals
    // the `click` event from the icons. Drag moves are tracked on `window`
    // so a drag still works if the pointer leaves the scene.
    scene.addEventListener('pointerdown', (e) => {
      endIntro();
      hidePreview();
      dragging = true;
      moved = 0;
      target = null;
      startX = e.clientX;
      startSpin = spin;
    });
    window.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > moved) moved = Math.abs(dx);
      spin = startSpin - dx * 0.006; // ring follows the hand
    });
    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      snapTo(frontIndex());
    };
    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);

    nodes.forEach((node, i) => {
      node.addEventListener('click', () => {
        if (moved > 6) return; // was a drag
        if (i === active) {
          openDetail(node, i);
        } else {
          snapTo(i);
        }
      });
    });

    detailBack.addEventListener('click', closeDetail);

    scene.addEventListener('keydown', (e) => {
      endIntro();
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        snapTo(active + 1);
      } else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        snapTo(active - 1);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && stage.classList.contains('is-detail')) {
        closeDetail();
      }
    });
  }
</script>
