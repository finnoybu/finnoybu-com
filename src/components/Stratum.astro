---
type Tone = 'deep' | 'mid' | 'warm' | 'light';

interface Props {
  id: string;
  label: string;
  period: string;
  blurb?: string;
  tone: Tone;
}

const { id, label, period, blurb, tone } = Astro.props;

// Tone → text + accent classes. Background is the body's continuous
// gradient (see global.css); strata are intentionally transparent.
const toneClasses: Record<Tone, { ink: string; muted: string; rule: string; eyebrow: string; period: string; blurb: string }> = {
  deep: {
    ink: 'text-stratum-deep-ink',
    muted: 'text-stratum-deep-muted',
    rule: 'bg-stratum-deep-ink/20',
    eyebrow: 'text-brass',
    period: 'text-stratum-deep-muted',
    blurb: 'text-stratum-deep-muted',
  },
  mid: {
    ink: 'text-stratum-mid-ink',
    muted: 'text-stratum-mid-muted',
    rule: 'bg-stratum-mid-ink/15',
    eyebrow: 'text-brass',
    period: 'text-stratum-mid-muted',
    blurb: 'text-stratum-mid-ink/85',
  },
  warm: {
    ink: 'text-stratum-warm-ink',
    muted: 'text-stratum-warm-ink/65',
    rule: 'bg-stratum-warm-ink/20',
    eyebrow: 'text-brass',
    period: 'text-stratum-warm-ink/65',
    blurb: 'text-stratum-warm-ink/85',
  },
  light: {
    ink: 'text-stratum-light-ink',
    muted: 'text-stratum-light-muted',
    rule: 'bg-stratum-light-ink/15',
    eyebrow: 'text-brass',
    period: 'text-stratum-light-muted',
    blurb: 'text-stratum-light-ink/85',
  },
};

const t = toneClasses[tone];
const headingFont = tone === 'light' ? 'font-display' : 'font-display';
---
<section id={id} class={`relative ${t.ink}`}>
  <div class="mx-auto max-w-shell px-6 md:px-10 py-20 md:py-28">
    <header class="mb-12 md:mb-16">
      <p class={`eyebrow ${t.eyebrow} mb-3`}>{label}</p>
      <div class="flex items-baseline gap-4 mb-4">
        <h2 class={`${headingFont} text-4xl md:text-5xl font-medium leading-tight tracking-tight`}>
          {label}
        </h2>
        <span class={`font-mono text-xs ${t.period}`}>{period}</span>
      </div>
      {blurb && (
        <p class={`max-w-prose text-base md:text-lg leading-relaxed ${t.blurb}`}>
          {blurb}
        </p>
      )}
      <div class={`mt-8 h-px ${t.rule}`} />
    </header>

    <div>
      <slot />
    </div>
  </div>
</section>
