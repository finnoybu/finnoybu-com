---
import PageLayout from '~/layouts/PageLayout.astro';

export const prerender = true;
---
<PageLayout
  title="Contact"
  description="Get in touch with Ken Tannenbaum."
>
  <article class="page-shell">
    <p class="eyebrow">Contact</p>
    <h1 class="page-title">Get in touch</h1>

    <div class="prose">
      <p>
        finnoybu.com is built and maintained by Ken Tannenbaum. For anything at
        all &mdash; a question, a project inquiry, or a correction &mdash; email
        is the surest way to reach me.
      </p>
      <p>
        <strong>Email:</strong>{' '}
        <a href="mailto:hello@finnoybu.com">hello@finnoybu.com</a>
      </p>
      <p>
        <strong>GitHub:</strong>{' '}
        <a href="https://github.com/finnoybu" target="_blank" rel="noopener noreferrer">
          github.com/finnoybu
        </a>
      </p>
      <p>
        Individual projects have their own contact channels &mdash; you'll find
        those on each project's own site.
      </p>
    </div>
  </article>
</PageLayout>
