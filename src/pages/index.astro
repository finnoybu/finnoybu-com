---
import BaseLayout from '~/layouts/BaseLayout.astro';
import SaturnRing from '~/components/SaturnRing.astro';
import { PROJECTS } from '~/data/projects';
---
<BaseLayout>
  <main class="page">
    <header class="hero">
      <p class="eyebrow">finnoybu.com</p>
      <h1 class="hero__name">Ken&nbsp;Tannenbaum</h1>
      <p class="hero__role">Software Engineer, Author, Entrepreneur</p>
      <p class="hero__blurb">Welcome to my corner of the universe</p>
    </header>

    <SaturnRing projects={PROJECTS} />

    <footer class="site-footer">
      <span class="site-footer__mark">finnoybu.com</span>
      <span class="site-footer__links">
        <a href="https://github.com/finnoybu">github</a>
        <a href="mailto:hello@finnoybu.com">hello@finnoybu.com</a>
      </span>
    </footer>
  </main>
</BaseLayout>

<style>
  .page {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .hero {
    text-align: center;
    padding-top: clamp(1rem, 3vh, 2.25rem);
    padding-bottom: clamp(0.5rem, 2vh, 1.5rem);
  }
  .hero .eyebrow {
    display: block;
    margin-bottom: 1.1rem;
  }
  .hero__name {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 500;
    font-size: clamp(2.6rem, 6.5vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--ink);
  }
  .hero__role {
    margin: 0.95rem 0 0;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .hero__blurb {
    margin: 1.35rem 0 0;
    font-size: 1.02rem;
    color: var(--ink-muted);
  }

  .site-footer {
    margin-top: auto;
    padding: 2rem 0 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    font-size: 0.78rem;
    color: var(--ink-faint);
    border-top: 1px solid var(--rule);
  }
  .site-footer a {
    color: var(--ink-muted);
    text-decoration: none;
    margin-left: 1.25rem;
    transition: color 0.2s ease;
  }
  .site-footer a:first-child { margin-left: 0; }
  .site-footer a:hover { color: var(--accent-hi); }
</style>
