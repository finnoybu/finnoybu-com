---
import BaseLayout from '~/layouts/BaseLayout.astro';
import SaturnRing from '~/components/SaturnRing.astro';
import { PROJECTS } from '~/data/projects';
---
<BaseLayout>
  <main class="page">
    <header class="hero">
      <p class="eyebrow">finnoybu.com</p>
      <h1 class="hero__name">Kenneth&nbsp;Tannenbaum</h1>
      <p class="hero__role">
        Senior Staff QA Engineer &middot; Founder of the AEGIS Initiative
      </p>
    </header>

    <SaturnRing projects={PROJECTS} />

    <p class="saturn-hint">
      drag the ring &middot; click an icon to focus, click again to visit &middot;
      &larr;&nbsp;&rarr;&nbsp;arrow keys
    </p>

    <footer class="site-footer">
      <span class="site-footer__mark">finnoybu.com</span>
      <span class="site-footer__links">
        <a href="https://github.com/finnoybu">github</a>
        <a href="mailto:hello@finnoybu.com">hello@finnoybu.com</a>
      </span>
    </footer>
  </main>
</BaseLayout>

<style>
  .page {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .hero {
    text-align: center;
    padding-top: clamp(3rem, 9vh, 6rem);
    padding-bottom: clamp(0.5rem, 2vh, 1.5rem);
  }
  .hero .eyebrow {
    display: block;
    margin-bottom: 1.1rem;
  }
  .hero__name {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 500;
    font-size: clamp(2.6rem, 6.5vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--ink);
  }
  .hero__role {
    margin: 1rem 0 0;
    font-size: clamp(0.82rem, 1.6vw, 0.98rem);
    color: var(--ink-muted);
    letter-spacing: 0.01em;
  }

  .site-footer {
    margin-top: auto;
    padding: 2rem 0 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    font-size: 0.78rem;
    color: var(--ink-faint);
    border-top: 1px solid var(--rule);
  }
  .site-footer a {
    color: var(--ink-muted);
    text-decoration: none;
    margin-left: 1.25rem;
    transition: color 0.2s ease;
  }
  .site-footer a:first-child { margin-left: 0; }
  .site-footer a:hover { color: var(--brass-hi); }
</style>
