---
import BaseLayout from '~/layouts/BaseLayout.astro';
import SaturnRing from '~/components/SaturnRing.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import { PROJECTS } from '~/data/projects';
---
<BaseLayout>
  <main class="page">
    <header class="hero">
      <p class="eyebrow">finnoybu.com</p>
      <h1 class="hero__name">Ken&nbsp;Tannenbaum</h1>
      <p class="hero__role">Software Engineer, Author, Entrepreneur</p>
      <p class="hero__blurb">Welcome to my corner of the universe</p>
    </header>

    <SaturnRing projects={PROJECTS} />
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .page {
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .hero {
    text-align: center;
    padding-top: clamp(1rem, 3vh, 2.25rem);
    padding-bottom: clamp(0.5rem, 2vh, 1.5rem);
  }
  .hero .eyebrow {
    display: block;
    margin-bottom: 1.1rem;
  }
  .hero__name {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 500;
    font-size: clamp(2.6rem, 6.5vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--ink);
  }
  .hero__role {
    margin: 0.95rem 0 0;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .hero__blurb {
    margin: 1.35rem 0 0;
    font-size: 1.02rem;
    color: var(--ink-muted);
  }
</style>
