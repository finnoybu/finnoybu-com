---
import PageLayout from '~/layouts/PageLayout.astro';
import PolicyArticle from '~/components/PolicyArticle.astro';
import { PRIVACY_SECTIONS, PRIVACY_LAST_UPDATED } from '~/data/privacy';
---
<PageLayout
  title="Privacy Policy"
  description="How finnoybu.com handles your data — a static site that collects no personal information."
>
  <PolicyArticle
    eyebrow="Privacy"
    title="Privacy Policy"
    updated={PRIVACY_LAST_UPDATED}
    sections={PRIVACY_SECTIONS}
  />
</PageLayout>
