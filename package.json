{
  "name": "finnoybu-com",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Kenneth Tannenbaum — personal landing page on Cloudflare Workers (Astro 6; migrated from Pages 2026-06). Stratified scroll concept that enacts the trajectory from hobbyist-Finn (2018) to AEGIS-architect (2026). Also the central Better Auth / OAuth host for the .finnoybu.com family.",
  "scripts": {
