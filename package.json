    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.45.2",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260526.1",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.31.10",
    "wrangler": "^4.95.0"
  },
  "overrides": {
    "@astrojs/check": {
      "yaml": "^2.8.3"
    }
  }
